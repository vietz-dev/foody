{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents",
    ".claude",
    "pnpm-lock.yaml",
    "helm/**/templates",
    "**/CHANGELOG.md",
    "**/next-env.d.ts"
  ]
}
