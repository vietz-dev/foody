{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "prisma:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/prisma/**"]
    },
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "OIDC_ISSUER",
        "OIDC_CLIENT_ID",
        "OIDC_CLIENT_SECRET",
        "ANTHROPIC_API_KEY",
        "PICNIC_TOKEN_SECRET",
        "API_URL",
        "PORT"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["transit", "prisma:generate"]
    },
    "test": {
      "dependsOn": ["transit", "prisma:generate"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "dev": {
      "dependsOn": ["prisma:generate"],
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "OIDC_ISSUER",
        "OIDC_CLIENT_ID",
        "OIDC_CLIENT_SECRET",
        "ANTHROPIC_API_KEY",
        "PICNIC_TOKEN_SECRET",
        "API_URL",
        "PORT"
      ],
      "cache": false,
      "persistent": true
    },
    "dev:proxy": {
      "dependsOn": ["prisma:generate"],
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "OIDC_ISSUER",
        "OIDC_CLIENT_ID",
        "OIDC_CLIENT_SECRET",
        "ANTHROPIC_API_KEY",
        "PICNIC_TOKEN_SECRET",
        "API_URL",
        "PORT"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
